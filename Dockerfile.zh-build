# FinceptTerminal 繁體中文版 — 多階段建構
# 使用 aqtinstall 安裝 Qt 6.8.3

# ============================================================
# 階段 1：編譯
# ============================================================
FROM ubuntu:24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Taipei

# 建構工具 + aqtinstall 的 Python
RUN apt-get update && apt-get install -y \
    build-essential cmake ninja-build git \
    python3 python3-pip python3-venv \
    libgl1-mesa-dev libglu1-mesa-dev \
    libx11-dev libx11-xcb-dev libxcb1-dev \
    libxcb-glx0-dev libxcb-keysyms1-dev \
    libxcb-image0-dev libxcb-shm0-dev \
    libxcb-icccm4-dev libxcb-sync-dev \
    libxcb-xfixes0-dev libxcb-shape0-dev \
    libxcb-randr0-dev libxcb-render-util0-dev \
    libxcb-xinerama0-dev libxcb-xkb-dev \
    libxkbcommon-dev libxkbcommon-x11-dev \
    libssl-dev libfontconfig1-dev libfreetype6-dev \
    libharfbuzz-dev libjpeg-dev libpng-dev \
    libsqlite3-dev libdbus-1-dev \
    libglib2.0-dev libatspi2.0-dev \
    libxrender-dev libxi-dev libxtst-dev \
    libpulse-dev libasound2-dev \
    libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev \
    libdrm-dev libgbm-dev libegl1-mesa-dev \
    pkg-config wget \
    && rm -rf /var/lib/apt/lists/*

# 用 aqtinstall 安裝 Qt 6.8.3（含 linguist tools 用於 lrelease 翻譯編譯）
RUN pip3 install --break-system-packages aqtinstall && \
    aqt install-qt linux desktop 6.8.3 linux_gcc_64 \
      --outputdir /opt/qt \
      -m qtcharts qtwebsockets qtmultimedia qtspeech qt5compat && \
    aqt install-tool linux desktop tools_qtlinguist qt.tools.qtlinguist \
      --outputdir /opt/qt 2>/dev/null || true && \
    echo "Qt 6.8.3 安裝完成"

ENV Qt6_DIR=/opt/qt/6.8.3/gcc_64
ENV CMAKE_PREFIX_PATH=${Qt6_DIR}
ENV PATH=${Qt6_DIR}/bin:${PATH}
ENV LD_LIBRARY_PATH=${Qt6_DIR}/lib:${LD_LIBRARY_PATH}

WORKDIR /build

# 複製原始碼
COPY fincept-qt/ ./fincept-qt/

# 先用 lrelease 編譯翻譯檔 .ts → .qm
RUN mkdir -p /build/fincept-qt/translations && \
    if [ -f /build/fincept-qt/translations/fincept_zh_TW.ts ]; then \
        ${Qt6_DIR}/bin/lrelease /build/fincept-qt/translations/fincept_zh_TW.ts \
            -qm /build/fincept-qt/translations/fincept_zh_TW.qm 2>&1 || \
        echo "[i18n] lrelease 可能不在 PATH，嘗試 linguist-tools..." ; \
    fi

# CMake 配置
RUN cd /build/fincept-qt && \
    cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_PREFIX_PATH=${Qt6_DIR} \
        -DCMAKE_INSTALL_PREFIX=/opt/fincept \
        2>&1 | tee /tmp/cmake_config.log | tail -30

# 建構（限制平行數為 2，避免 x86_64 模擬 OOM）
RUN cd /build/fincept-qt && \
    cmake --build build --parallel 2 2>&1 | tee /tmp/cmake_build.log | tail -50

# 安裝
RUN cd /build/fincept-qt/build && \
    mkdir -p /opt/fincept/bin /opt/fincept/lib /opt/fincept/translations && \
    cp FinceptTerminal /opt/fincept/bin/ 2>/dev/null || true && \
    # 複製翻譯檔（從 build 輸出目錄 + 原始碼目錄都嘗試）
    find /build/fincept-qt/build -name "*.qm" -exec cp {} /opt/fincept/translations/ \; 2>/dev/null || true && \
    cp /build/fincept-qt/translations/*.qm /opt/fincept/translations/ 2>/dev/null || true && \
    # 複製 Qt runtime libs
    cp -a ${Qt6_DIR}/lib/libQt6*.so* /opt/fincept/lib/ 2>/dev/null || true && \
    cp -a ${Qt6_DIR}/plugins /opt/fincept/ 2>/dev/null || true && \
    # 複製建構過程中的第三方依賴庫（如 libqgeoview）
    find /build/fincept-qt/build/_deps -name "*.so*" -exec cp -a {} /opt/fincept/lib/ \; 2>/dev/null || true && \
    # 複製 Qt 附帶的 ICU 和其他共享庫
    cp -a ${Qt6_DIR}/lib/libicu*.so* /opt/fincept/lib/ 2>/dev/null || true && \
    cp -a ${Qt6_DIR}/lib/libQt6*.so* /opt/fincept/lib/ 2>/dev/null || true && \
    # 複製 resources 目錄（含 requirements-numpy1/2.txt 等安裝所需檔案）
    cp -r /build/fincept-qt/resources /opt/fincept/bin/resources 2>/dev/null || true

# ============================================================
# 階段 2：執行環境
# ============================================================
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Taipei
ENV LANG=zh_TW.UTF-8
ENV LC_ALL=zh_TW.UTF-8
ENV FINCEPT_LANG=zh_TW

RUN apt-get update && apt-get install -y \
    libgl1-mesa-dri libegl1 libegl-mesa0 libgbm1 \
    libopengl0 libglx0 libglx-mesa0 \
    libx11-6 libxcb1 libxkbcommon0 libxkbcommon-x11-0 \
    libxcb-cursor0 libxcb-keysyms1 libxcb-shape0 \
    libxcb-xfixes0 libxcb-randr0 libxcb-render-util0 \
    libxcb-icccm4 libxcb-image0 libxcb-shm0 \
    libxcb-sync1 libxcb-xinerama0 libxcb-xkb1 \
    libxcb-glx0 libxcb-render0 \
    libfontconfig1 libfreetype6 libharfbuzz0b \
    libdbus-1-3 libglib2.0-0 \
    libpulse0 libdrm2 libxrender1 libxi6 libxtst6 \
    libsqlite3-0 libssl3t64 \
    libgstreamer1.0-0 libgstreamer-plugins-base1.0-0 \
    xvfb x11vnc novnc websockify fluxbox \
    fonts-noto-cjk fonts-noto-cjk-extra \
    locales curl ca-certificates netcat-openbsd \
    # 預烘焙 Python 套件編譯所需（PyAudio 需 portaudio + gcc）
    build-essential gcc g++ \
    portaudio19-dev libffi-dev libsqlite3-dev \
    libhdf5-dev pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN locale-gen zh_TW.UTF-8

# 從建構階段複製
COPY --from=builder /opt/fincept /opt/fincept

ENV LD_LIBRARY_PATH=/opt/fincept/lib
ENV QT_PLUGIN_PATH=/opt/fincept/plugins

# ============================================================
# 預烘焙 Python 環境（跳過 First-Time Setup 的 3-5 分鐘等待）
# ============================================================
# 根據 PythonSetupManager.cpp check_status() Fast-Path 判定：
#   1. .setup_complete sentinel 存在
#   2. uv/uv 二進位存在
#   3. venv-numpy1/bin/python3 存在 + .packages_installed = SHA-256
#   4. venv-numpy2/bin/python3 存在 + .packages_installed = SHA-256
#
# 路徑：AppPaths::root() = $HOME/.local/share/com.fincept.terminal
#        容器內 $HOME=/root → /root/.local/share/com.fincept.terminal

ENV FINCEPT_ROOT=/root/.local/share/com.fincept.terminal
ENV UV_VERSION=0.7.12
ENV PYTHON_VERSION=3.12.7

# Step 1: 下載 UV 二進位（對應 uv_path() = ${FINCEPT_ROOT}/uv/uv）
RUN mkdir -p ${FINCEPT_ROOT}/uv && \
    curl -fsSL "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-x86_64-unknown-linux-musl.tar.gz" \
      | tar xzf - -C ${FINCEPT_ROOT}/uv --strip-components=1 && \
    chmod +x ${FINCEPT_ROOT}/uv/uv && \
    ${FINCEPT_ROOT}/uv/uv --version

# Step 2: 用 UV 安裝 Python 3.12.7（對應 base_python_path()）
RUN UV_PYTHON_INSTALL_DIR=${FINCEPT_ROOT}/python \
    ${FINCEPT_ROOT}/uv/uv python install ${PYTHON_VERSION}

# Step 3: 建立 venv-numpy1 和 venv-numpy2
#   對應 python_path("venv-numpy1") = ${FINCEPT_ROOT}/venv-numpy1/bin/python3
RUN UV_PYTHON_INSTALL_DIR=${FINCEPT_ROOT}/python \
    ${FINCEPT_ROOT}/uv/uv venv ${FINCEPT_ROOT}/venv-numpy1 --python ${PYTHON_VERSION} && \
    UV_PYTHON_INSTALL_DIR=${FINCEPT_ROOT}/python \
    ${FINCEPT_ROOT}/uv/uv venv ${FINCEPT_ROOT}/venv-numpy2 --python ${PYTHON_VERSION}

# Step 4a: 安裝 numpy1 套件
#   注意：使用容器內已複製的 resources 路徑，確保 SHA-256 與 runtime 一致
#   PEEWEE_NO_SQLITE_EXTENSIONS=1 避免 peewee C 擴展編譯失敗（缺 sqlite3.h）
RUN UV_PYTHON_INSTALL_DIR=${FINCEPT_ROOT}/python \
    UV_COMPILE_BYTECODE=1 \
    UV_HTTP_TIMEOUT=120 \
    PEEWEE_NO_SQLITE_EXTENSIONS=1 \
    ${FINCEPT_ROOT}/uv/uv pip install \
      --python ${FINCEPT_ROOT}/venv-numpy1/bin/python3 \
      -r /opt/fincept/bin/resources/requirements-numpy1.txt

# Step 4b: 安裝 numpy2 套件（ML/AI 重度依賴，需要較長時間）
RUN UV_PYTHON_INSTALL_DIR=${FINCEPT_ROOT}/python \
    UV_COMPILE_BYTECODE=1 \
    UV_HTTP_TIMEOUT=120 \
    PEEWEE_NO_SQLITE_EXTENSIONS=1 \
    ${FINCEPT_ROOT}/uv/uv pip install \
      --python ${FINCEPT_ROOT}/venv-numpy2/bin/python3 \
      -r /opt/fincept/bin/resources/requirements-numpy2.txt

# Step 5: 寫入 .packages_installed marker
#   check_status() 的 Fast-Path 比對：stored_hash == compute_requirements_hash(file)
#   compute_requirements_hash() 使用 QCryptographicHash::Sha256 讀整個檔案
#   sha256sum 行為相同（binary SHA-256），直接使用容器內的 requirements 檔案確保一致
RUN sha256sum /opt/fincept/bin/resources/requirements-numpy1.txt | awk '{print $1}' \
      > ${FINCEPT_ROOT}/venv-numpy1/.packages_installed && \
    sha256sum /opt/fincept/bin/resources/requirements-numpy2.txt | awk '{print $1}' \
      > ${FINCEPT_ROOT}/venv-numpy2/.packages_installed && \
    echo "[預烘焙] numpy1 marker: $(cat ${FINCEPT_ROOT}/venv-numpy1/.packages_installed)" && \
    echo "[預烘焙] numpy2 marker: $(cat ${FINCEPT_ROOT}/venv-numpy2/.packages_installed)"

# Step 6: 寫入 .setup_complete sentinel + 建立必要目錄
RUN echo "ok" > ${FINCEPT_ROOT}/.setup_complete && \
    mkdir -p ${FINCEPT_ROOT}/{data,cache,logs,models,runtime,workspaces,files,crashdumps} && \
    echo "[預烘焙] ✅ 預烘焙完成 — Fast-Path 4 條件已就位"

# 驗證預烘焙結果
RUN echo "=== 預烘焙驗證 ===" && \
    echo "1. sentinel: $(test -f ${FINCEPT_ROOT}/.setup_complete && echo OK || echo MISSING)" && \
    echo "2. uv: $(${FINCEPT_ROOT}/uv/uv --version 2>/dev/null || echo MISSING)" && \
    echo "3. venv1 python: $(test -f ${FINCEPT_ROOT}/venv-numpy1/bin/python3 && echo OK || echo MISSING)" && \
    echo "4. venv2 python: $(test -f ${FINCEPT_ROOT}/venv-numpy2/bin/python3 && echo OK || echo MISSING)" && \
    echo "5. venv1 marker: $(cat ${FINCEPT_ROOT}/venv-numpy1/.packages_installed)" && \
    echo "6. venv2 marker: $(cat ${FINCEPT_ROOT}/venv-numpy2/.packages_installed)" && \
    echo "7. numpy1 test: $(${FINCEPT_ROOT}/venv-numpy1/bin/python3 -c 'import numpy; print(numpy.__version__)' 2>&1)" && \
    echo "8. numpy2 test: $(${FINCEPT_ROOT}/venv-numpy2/bin/python3 -c 'import numpy; print(numpy.__version__)' 2>&1)"

# 清理 UV 快取（節省 image 空間）
RUN rm -rf ${FINCEPT_ROOT}/uv-cache /root/.cache

# ============================================================
# 容器配置
# ============================================================

COPY docker-entrypoint-zh.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# KTW SaaS 環境變數宣告（容器啟動時由外部注入值）
ENV KTW_SAAS_URL=""
ENV KTW_TENANT_ID=""
ENV KTW_JWT_TOKEN=""
ENV KTW_LLM_TIER="L1"
ENV KTW_INTELLIGENCE_ENABLED="true"
ENV KTW_TRADING_ENABLED="false"
ENV KTW_HEALTH_PORT=""

# 租戶資料卷掛載點
VOLUME ["/data/tenant"]

EXPOSE 6080
EXPOSE 8888

ENTRYPOINT ["/entrypoint.sh"]
